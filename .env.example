# Roans Server Manager - every variable this program reads.
#
# Copy to .env and edit. .env is gitignored; this file is the documentation.

# Shared secret required on every /api/* route (X-SM-Token header,
# "Authorization: Bearer <token>" or ?token=<token>). Leave empty to rely on the
# 127.0.0.1 bind alone - fine while the panel is only reachable from this host,
# mandatory the moment anything can reach it (Tailscale, tunnel, proxy).
SM_TOKEN=

# Where the panel listens ON THE HOST. Keep the host part at 127.0.0.1.
SM_BIND=127.0.0.1
SM_PORT=8303

# Optional display name for the server in the UI header.
SM_SERVER_NAME=Roans-Server

# Host mounts, so the collectors describe the host and not the container.
SM_HOST_PROC=/host/proc
SM_HOST_SYS=/host/sys
SM_HOST_ROOT=/host/root
SM_DOCKER_SOCKET=/var/run/docker.sock

# Comma-separated roots the (future) file browser may read. Defaults to /srv.
SM_FILE_ROOTS=/srv
